# Modelo das variáveis. Valores: Lovable Cloud (Project settings → Cloud / Supabase).
# O .env real é gerado e versionado pelo próprio Lovable e só tem valores públicos.

# Navegador (Vite): públicas por natureza; a proteção dos dados é a RLS do banco.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Servidor (funções de servidor do TanStack Start): as mesmas URL e chave pública.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# NUNCA coloque aqui a service_role (SUPABASE_SERVICE_ROLE_KEY), sb_secret_ ou outra chave secreta.
# Segredos ficam só em: Lovable → Cloud → Secrets (lidos no servidor via process.env).
